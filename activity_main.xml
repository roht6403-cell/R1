<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="match_parent">
 <TextView android:text="Offline Mail Merge" android:textSize="26sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
 <TextView android:text="Excel/CSV → 10 Questions per A4 Page → PDF" android:textSize="15sp" android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
 <Button android:id="@+id/selectFile" android:text="1. Select CSV" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="25dp"/>
 <EditText android:id="@+id/questionsPerPage" android:inputType="number" android:text="10" android:hint="Questions per page" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <EditText android:id="@+id/questionTemplate" android:hint="Question template, e.g. {{Question}}" android:text="{{Question}}" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <Button android:id="@+id/generate" android:text="2. Generate PDF" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp"/>
 <TextView android:id="@+id/status" android:text="Select a CSV file to begin." android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
